<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 深色主题（默认）。所有控件只引用资源键，禁止硬编码色值。 -->
  <SolidColorBrush x:Key="WindowBgBrush" Color="#1B1D21" />
  <SolidColorBrush x:Key="PanelBgBrush" Color="#22252A" />
  <SolidColorBrush x:Key="PanelAltBgBrush" Color="#282C32" />
  <SolidColorBrush x:Key="DividerBrush" Color="#343A42" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E7EAEE" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A2AAB4" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="#707985" />
  <SolidColorBrush x:Key="AccentBrush" Color="#4C8DFF" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#6AA3FF" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="#3A73DB" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#3CCB7F" />
  <SolidColorBrush x:Key="WarningBrush" Color="#E5A54B" />
  <SolidColorBrush x:Key="ErrorBrush" Color="#E05561" />
  <SolidColorBrush x:Key="ControlBgBrush" Color="#2B2F36" />
  <SolidColorBrush x:Key="ControlBorderBrush" Color="#3D444D" />
  <SolidColorBrush x:Key="HoverBgBrush" Color="#343A43" />
  <SolidColorBrush x:Key="SelectedBgBrush" Color="#3A424E" />
  <SolidColorBrush x:Key="SwitchOffBrush" Color="#3A4048" />
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#4A525C" />
  <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#5B646F" />
</ResourceDictionary>
