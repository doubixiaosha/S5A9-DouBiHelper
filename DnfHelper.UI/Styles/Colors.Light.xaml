<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 浅色主题：与 Colors.Dark.xaml 资源键一一对应。 -->
  <SolidColorBrush x:Key="WindowBgBrush" Color="#F3F5F8" />
  <SolidColorBrush x:Key="PanelBgBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="PanelAltBgBrush" Color="#EDF1F5" />
  <SolidColorBrush x:Key="DividerBrush" Color="#D8DEE6" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1E2329" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5A636E" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="#8A939E" />
  <SolidColorBrush x:Key="AccentBrush" Color="#2F6FE0" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#4682EE" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="#255BB8" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#1E9E5B" />
  <SolidColorBrush x:Key="WarningBrush" Color="#C07A16" />
  <SolidColorBrush x:Key="ErrorBrush" Color="#C63A45" />
  <SolidColorBrush x:Key="ControlBgBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ControlBorderBrush" Color="#C9D1DA" />
  <SolidColorBrush x:Key="HoverBgBrush" Color="#EAF0F7" />
  <SolidColorBrush x:Key="SelectedBgBrush" Color="#DDE8F8" />
  <SolidColorBrush x:Key="SwitchOffBrush" Color="#D3DAE2" />
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#B7C0CA" />
  <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#98A3AF" />
  <SolidColorBrush x:Key="LogInfoBrush" Color="#2B323A" />
  <SolidColorBrush x:Key="LogWarnBrush" Color="#A8680F" />
  <SolidColorBrush x:Key="LogErrorBrush" Color="#B32B37" />
</ResourceDictionary>
