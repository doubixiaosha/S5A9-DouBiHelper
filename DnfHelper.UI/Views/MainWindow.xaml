<Window x:Class="DnfHelper.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DouBi Helper"
        Icon="pack://application:,,,/Assets/DNF.ico"
        Width="400" Height="880" MinWidth="400" MinHeight="880"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource UiFontFamily}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                  GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="48" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ================= 首行：LOGO / 标题 / 主题 / 最小化 / 关闭 ================= -->
      <Grid Grid.Row="0" Background="{DynamicResource PanelBgBrush}"
            MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
          <Image x:Name="TitleIcon" Width="20" Height="20" Stretch="Uniform"
                 RenderOptions.BitmapScalingMode="HighQuality"
                 VerticalAlignment="Center" />
          <TextBlock Text="DouBi Helper" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0"
                     VerticalAlignment="Center" />
          <TextBlock Text="S5A9" Style="{StaticResource CaptionStyle}" Margin="8,0,0,0"
                     VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0"
                    VerticalAlignment="Center">
          <TextBlock Text="{Binding VersionText}" Style="{StaticResource CaptionStyle}"
                     FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
          <Button Style="{StaticResource IconButton}" Content="◐"
                  ToolTip="切换深浅主题" Command="{Binding ToggleThemeCommand}" />
          <Button Style="{StaticResource IconButton}" Content="—"
                  ToolTip="最小化" Click="Minimize_Click" Margin="2,0,0,0" />
          <Button Style="{StaticResource CloseButton}" Content="✕"
                  ToolTip="关闭" Click="Close_Click" Margin="2,0,0,0" />
        </StackPanel>
      </Grid>

      <!-- ================= 角色信息区：与标题区同一底色，无卡片装饰 ================= -->
      <Grid Grid.Row="1" Background="{DynamicResource PanelBgBrush}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Margin="12,0,12,8">
          <TextBlock Text="{Binding CharacterLine}" FontSize="11"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding LocationLine}" FontSize="11" Margin="0,2,0,0"
                     Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap">
            <TextBlock.Style>
              <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasLocationLine}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Text="{Binding RoomLine}" FontSize="11" Margin="0,2,0,0"
                     Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap">
            <TextBlock.Style>
              <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasRoomLine}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>

        <!-- 重连：始终可见可用，重新查找并附加 ARAD.EXE -->
        <Button Grid.Column="1" Content="重连" Style="{StaticResource SecondaryButton}"
                Height="22" Padding="8,0" Margin="0,0,10,0" VerticalAlignment="Top"
                Command="{Binding ReconnectCommand}"
                ToolTip="按进程名 ARAD.EXE 重新查找并附加" />
      </Grid>

      <!-- ================= 主体：竖版单列四个功能块 ================= -->
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12,10,12,0">

          <!-- 块 1：自动捡物 + 捡物配置 -->
          <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <Grid Margin="12,10,12,10">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="自动捡物" Style="{StaticResource CardTitleStyle}"
                           VerticalAlignment="Center" Margin="0" />
                <CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}"
                          IsChecked="{Binding PickupEnabled}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="开关启用后自动拾取"
                           Style="{StaticResource CardHintStyle}" />
              </Grid>

              <Border Grid.Row="1" Background="{DynamicResource DividerBrush}" Margin="12,0" />

              <Grid Grid.Row="2" Margin="12,10,12,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="方式" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding PickupModes}"
                          SelectedIndex="{Binding PickupModeIndex}" Margin="8,0,0,0"
                          HorizontalAlignment="Stretch" />
              </Grid>
            </Grid>
          </Border>

          <!-- 块 2：装备处理（启用开关 + 紧随其下的配置折叠区） -->
          <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
            <Grid Margin="12,10,12,10">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="装备处理" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="自动处理开关" Style="{StaticResource CaptionStyle}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <CheckBox Style="{StaticResource SwitchStyle}"
                          IsChecked="{Binding EquipEnabled}" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                         Text="开关打开时，每次从副本回到城镇自动触发一次；ALT+F 可随时手动触发一次"
                         Style="{StaticResource CardHintStyle}" TextWrapping="Wrap" />
            </Grid>
          </Border>

          <!-- 折叠区：装备处理配置（紧贴启用开关，六品质单选 + 豁免列表） -->
          <Expander Style="{StaticResource CollapseSectionStyle}" Margin="0,0,0,8"
                    IsExpanded="{Binding EquipExpanded, Mode=TwoWay}">
            <Expander.Header>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="装备处理配置" Style="{StaticResource CardTitleStyle}" />
                <TextBlock Text="动作 / 豁免列表" Style="{StaticResource CaptionStyle}"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Expander.Header>

            <StackPanel Margin="0,10,0,0">
              <TextBlock Text="{Binding Equip.Summary}" Style="{StaticResource CaptionStyle}"
                         TextWrapping="Wrap" />

              <!-- 六品质动作：每行品质名 + 三选一互斥单选 -->
              <ItemsControl ItemsSource="{Binding Equip.Rows}" Margin="0,10,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,6">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding QualityName}" Style="{StaticResource FieldLabelStyle}"
                                 VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Content="不处理" FontSize="12" VerticalAlignment="Center"
                                     GroupName="{Binding GroupName}"
                                     IsChecked="{Binding IsIgnore, Mode=TwoWay}" />
                        <RadioButton Content="卖物" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"
                                     GroupName="{Binding GroupName}"
                                     IsChecked="{Binding IsSell, Mode=TwoWay}" />
                        <RadioButton Content="分解" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"
                                     GroupName="{Binding GroupName}"
                                     IsChecked="{Binding IsDisassemble, Mode=TwoWay}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- 豁免列表：槽位 / 名称 / ID / 勾选 -->
              <Border Background="{DynamicResource ControlBgBrush}"
                      BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                      CornerRadius="6" Margin="0,2,0,0">
                <StackPanel>
                  <Grid Background="{DynamicResource PanelBgBrush}" Margin="0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="44" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="64" />
                      <ColumnDefinition Width="40" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="槽位" Style="{StaticResource CaptionStyle}" Margin="8,6,0,6" />
                    <TextBlock Grid.Column="1" Text="名称" Style="{StaticResource CaptionStyle}" Margin="4,6,0,6" />
                    <TextBlock Grid.Column="2" Text="ID" Style="{StaticResource CaptionStyle}" Margin="4,6,0,6" />
                    <TextBlock Grid.Column="3" Text="勾选" Style="{StaticResource CaptionStyle}" Margin="4,6,0,6" />
                    <Button Grid.Column="4" Content="刷新" Style="{StaticResource SecondaryButton}"
                            Height="20" Padding="6,0" FontSize="11" Margin="0,2,4,2"
                            VerticalAlignment="Center" Command="{Binding Equip.RefreshCommand}" />
                  </Grid>

                  <Border Background="{DynamicResource DividerBrush}" Height="1" />

                  <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                      <TextBlock Text="{Binding Equip.EmptyText}" FontSize="11"
                                 Foreground="{DynamicResource TextMutedBrush}"
                                 Margin="8,10,8,10" TextWrapping="Wrap">
                        <TextBlock.Style>
                          <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Equip.HasItems}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <ItemsControl ItemsSource="{Binding Equip.VisibleSlots}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border BorderBrush="{DynamicResource DividerBrush}"
                                  BorderThickness="0,0,0,1" Padding="0,2" ToolTip="{Binding TooltipText}">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="{Binding Slot}" FontSize="11"
                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                         VerticalAlignment="Center" Margin="8,0,0,0" />
                              <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="11"
                                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                         Margin="4,0,4,0" />
                              <TextBlock Grid.Column="2" Text="{Binding IdText}" FontSize="11"
                                         Foreground="{DynamicResource TextMutedBrush}"
                                         VerticalAlignment="Center" Margin="4,0,0,0" />
                              <CheckBox Grid.Column="3" HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                  </ScrollViewer>
                </StackPanel>
              </Border>

              <TextBlock Margin="0,10,0,0"
                         Text="勾选 = 该单件豁免（不处理），按槽位 1..56 对应；异界品质不处理。豁免勾选不写入配置文件（每次启动为空，扫描后按需重新勾选）。自动处理开关打开时，每次从副本回到城镇触发一次；ALT+F 可随时手动触发一次。"
                         Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
            </StackPanel>
          </Expander>

          <!-- 块 3：顺图 -->
          <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <Grid Margin="12,10,12,10">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="顺图" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" />
                <CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}"
                          IsChecked="{Binding TraverseEnabled}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="ALT + 方向键；关闭时热键无响应"
                           Style="{StaticResource CardHintStyle}" />
              </Grid>

              <Grid Grid.Row="1" Margin="12,10,12,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="方式" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding TraverseModes}"
                          SelectedIndex="{Binding TraverseModeIndex}" Margin="8,0,0,0"
                          HorizontalAlignment="Stretch" />
              </Grid>
            </Grid>
          </Border>

          <!-- 块 3.5：区域 · 特殊功能（BUFF / 自动物品） -->
          <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
            <StackPanel Margin="12,10,12,10">
              <TextBlock Text="区域 · 特殊功能" Style="{StaticResource CardTitleStyle}" />

              <StackPanel Margin="0,8,0,0">
                <TextBlock Text="BUFF" Style="{StaticResource FieldLabelStyle}" />
                <TextBlock Text="ALT+1 手动触发一次；填 BUFF 类型编号，逗号分隔"
                           Style="{StaticResource CardHintStyle}" TextWrapping="Wrap" />
              </StackPanel>
              <TextBox Text="{Binding BuffTypes}" Margin="0,6,0,0" VerticalContentAlignment="Center"
                       ToolTip="BUFF 类型编号，逗号或空格分隔，可填多个，例如 1218" />

              <Border Background="{DynamicResource DividerBrush}" Height="1" Margin="0,10,0,0" />

              <Grid Margin="0,10,0,0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="自动物品" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" />
                <CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}"
                          IsChecked="{Binding AutoItemEnabled}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                           Text="填 物品 ID（逗号分隔）。开关打开时，每次进入副本 1.5 秒后自动执行一次；ALT+2 可手动触发一次。"
                           Style="{StaticResource CardHintStyle}" TextWrapping="Wrap" />
              </Grid>
              <TextBox Text="{Binding AutoItemIds}" Margin="0,6,0,0" VerticalContentAlignment="Center"
                       ToolTip="物品 ID，逗号或空格分隔，可填多个" />
            </StackPanel>
          </Border>

          <!-- 块 3.6：魔界助手（独立卡片，配置段 [魔界助手]） -->
          <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
            <StackPanel Margin="12,10,12,10">
              <TextBlock Text="魔界助手" Style="{StaticResource CardTitleStyle}" />
              <TextBlock Text="注意：生效成功由服务端侧判定，发送成功 ≠ 已生效"
                         Style="{StaticResource CardHintStyle}" TextWrapping="Wrap" />

              <Grid Margin="0,10,0,0" MinHeight="20">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="助手版自动入包开关" Style="{StaticResource FieldLabelStyle}"
                           VerticalAlignment="Center" />
                <CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}"
                          IsChecked="{Binding HelperPickupEnabled}" VerticalAlignment="Center" />
              </Grid>

              <Grid Margin="0,10,0,0" MinHeight="20">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="深渊连刷开关" Style="{StaticResource FieldLabelStyle}"
                           VerticalAlignment="Center" />
                <CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}"
                          IsChecked="{Binding HelperHellEnabled}" VerticalAlignment="Center" />
              </Grid>

              <!-- 角色ID 只读回显：数据源为 CoreStatus.AutoCharacterId，每秒刷新 -->
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0" MinHeight="20"
                          VerticalAlignment="Center">
                <TextBlock Text="角色ID回显" Style="{StaticResource FieldLabelStyle}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding CharacterIdReadText}" Style="{StaticResource CaptionStyle}"
                           FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- ================= 块 4：底部热键说明 ================= -->
      <Grid Grid.Row="3" Background="{DynamicResource PanelBgBrush}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 热键说明：四行整体居中，强调色小字；第一/四行两段之间留大间隔 -->
        <StackPanel Grid.Row="0" Margin="12,8,10,8" HorizontalAlignment="Center">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="ALT+Q 自动拾取开关" FontSize="11"
                       Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Text="ALT+G 本地GM开关" FontSize="11" Margin="24,0,0,0"
                       Foreground="{DynamicResource AccentBrush}" />
          </StackPanel>
          <TextBlock Text="ALT+F 单次装备处理" FontSize="11" Margin="0,2,0,0"
                     HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
          <TextBlock Text="ALT+方向键对应方向顺图" FontSize="11" Margin="0,2,0,0"
                     HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
            <TextBlock Text="ALT+1单次BUFF" FontSize="11"
                       Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Text="ALT+2单次物品" FontSize="11" Margin="24,0,0,0"
                       Foreground="{DynamicResource AccentBrush}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
